# Local environments, caches, private backups and generated notebook previews.
.venv/
.runtime_stage_v1/
.mypy_cache/
.pytest_cache/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.local-backups/
.matplotlib/
.runtime_build/
.runtime_cache/
.sync_cache
.syncignore
build/
dist/
*.log
*.html

# Original data are read-only and stay local. Keep their descriptions and request.
/src/*
!/src/README.md
!/src/vasily_message.txt

# Generated data: retain only compact, reviewable JSON evidence and descriptions.
/data/**
!/data/**/
!/data/**/*.md
!/data/**/*.json
/data/dev_1_2_smoothing/provenance_runtime/
/data/dev_1_4_server_preparation/*/chunks/
/data/dev_1_4_server_preparation/*/work/
/data/dev_1_4_server_preparation/*/runtime_cache/

# Only curated illustrations are versioned; mass previews remain local.
/img/dev_1_1_preprocessing/previews/A/EFVB/
/img/dev_1_1_preprocessing/previews/A/ECVB/

# Native files and bulk array/model/archive formats never enter history.
*.so
*.dll
*.pyd
*.npz
*.npy
*.msh
*.vtu
*.vtk
*.pvd
*.sgy
*.segy
*.fc
*.fds
*.h5
*.hdf5
*.zip
*.tar
*.gz
*.7z
*.mp4

# Explicitly approved publication of the chapter 1.5 geometry/frequency galleries.
!/img/dev_1_5_geometry_frequency/series_v1/index.html
!/img/dev_1_5_geometry_frequency/series_v1/*/velocity.mp4
!/img/dev_1_5_geometry_frequency/linear_v1/index.html
!/img/dev_1_5_geometry_frequency/linear_v1/*/velocity.mp4
!/img/dev_1_5_geometry_frequency/linear_limit_1e-10_v1/index.html
!/img/dev_1_5_geometry_frequency/linear_limit_1e-10_v1/*/velocity.mp4
