+"""SEMGPU Test Card
+
+Пакет semgpu2, R095, T1. Два смежных квадрата p2 имеют разные материалы.
+Проверяются каталог, структурный допуск, массы, межэлементный интерфейс,
+взвешенные скорости, запись параметров Ламе, SAVE и паритет с FP64 tenzor.
+Запуск: .venv/bin/python -m pytest semgpu2/tests/tests_lin_elast_2d/seismic_newmark_kim/test_reg_seismic.py
+"""
+from __future__ import annotations
+
+from dataclasses import replace
+
+import numpy as np
+import pytest
+
+from semgpu2.model import SGMeshModel, SGPETALineModel
+from semgpu2.solvers import lin_elast_2d_seismic_newmark_kim_cu as seismic
+from semgpu2.solvers import lin_elast_2d_tenzor_newmark_kim_cu as tenzor
+from semgpu2.solvers.solver_api import (
+    Float64Array, SGBaseReceiverEventData, SGPhysicsData, SGReceiverData,
+    SGReceiverRunControl, SGSolverLifecycleState,
+)
+from semgpu2.tools.mesh.box import rectangle_quad
+
+
+def mesh() -> SGMeshModel:
+    return rectangle_quad(sizes=(2., 1.), elements=(2, 1), pets=[SGPETALineModel("line", order=2)])
+
+
+def test_catalog() -> None:
+    assert seismic.SOLVER_ID == "lin_elast_2d_seismic_newmark_kim_cu"
+    assert list(map(int, seismic.SGPhysicsTypeEnum)) == [11000, 20200, 30001, 32000]
+    assert list(map(int, seismic.SGReceiverComponentEnum)) == [4, 5]
+    assert [row.name for row in seismic.SGQMainMaterialsComponentEnum] == ["DENSITY", "LAMBDA", "MU"]
+    assert [row.name for row in seismic.SGNResponseComponentEnum] == ["FORCE_X", "FORCE_Y"]
+    assert not seismic.SGSolverConfig().check_finite_each_step
+
+
+def test_structural_pet() -> None:
+    from semgpu2.solvers.lin_elast_2d_seismic_newmark_kim_cu import _native
+
+    domain = mesh()
+    pets = domain.build_pets_data()
+    spaces = {k: domain.build_pq_space_data(k) for k in domain.strata}
+    _native.validate_structure(len(domain.nodes_coords), pets, spaces)
+    values = pets.pq_values.copy()
+    values[0] += 1e-6
+    with pytest.raises(seismic.SGCompileError) as error:
+        _native.validate_structure(len(domain.nodes_coords), replace(pets, pq_values=values), spaces)
+    assert error.value.code == seismic.SGCompileErrorCodeEnum.STRUCTURE_FAILURE
+
+
+def setup(domain: SGMeshModel, solver: seismic.SGSolver | tenzor.SGSolver, young_scale: float = 1.) -> None:
+    solver.compile(len(domain.nodes_coords), domain.build_pets_data(),
+                   {k: domain.build_pq_space_data(k) for k in domain.strata})
+    solver.mesh(domain.build_n_coords())
+    for e, (rho, young, nu) in enumerate(((2., 10., .25), (3., 21., .2))):
+        values = np.repeat(np.array([[rho], [young_scale * young], [nu]]), 9, axis=1)
+        solver.physics[e] = SGPhysicsData(11000, 1, np.array([e], dtype=np.int64), values)
+    source = np.array([0], dtype=np.int64)
+    solver.physics[2] = SGPhysicsData(20200, 0, source, np.array([[[1.], [-2.]], [[.3], [4.]]]),
+                                      t_begin=0., t_end=.01, interp_code=1)
+    for i, alpha in enumerate((.3, .7)):
+        solver.physics[3+i] = SGPhysicsData(30001, 0, source, np.array([[alpha]]))
+    edges = np.asarray(domain.elements_filter(2), dtype=np.int64)
+    solver.physics[5] = SGPhysicsData(32000, 2, edges, np.repeat([[.7], [1.2]], 3 * edges.size, axis=1))
+
+
+def receiver() -> SGReceiverData:
+    return SGReceiverData(0, np.array([5, 4], dtype=np.int32), np.array([0, 1, 0], dtype=np.int64),
+                          np.zeros(3, dtype=np.int64), np.array([.25, .5, .25]), 1, 0, -1, 1, 2)
+
+
+def history(solver: seismic.SGSolver | tenzor.SGSolver, sync: bool) -> Float64Array:
+    frames: list[Float64Array] = []
+
+    def receive(receiver_index: int, frame: Float64Array, event: SGBaseReceiverEventData, control: SGReceiverRunControl) -> None:
+        frames.append(frame.copy())
+        if event.tact == 4:
+            control.save()
+
+    probes = [receiver()]
+    outcome = solver.run(probes, receive, sync=True) if sync else solver.run(probes, receive).wait()
+    assert outcome.code == seismic.SGRunCodeEnum.TIME_END
+    assert len(frames) == 5
+    return np.stack(frames)
+
+
+@pytest.mark.parametrize("sync", [True, False])
+def test_seismic_matches_tenzor(sync: bool) -> None:
+    domain = mesh()
+    actual = seismic.SGSolver(seismic.SGSolverConfig(t_end=.01, steps_count=8, tacts_count=4, kim_beta=1/27,
+                                                     check_finite_each_step=sync))
+    reference = tenzor.SGSolver(tenzor.SGSolverConfig(t_end=.01, steps_count=8, tacts_count=4, kim_beta=1/27))
+    setup(domain, actual)
+    setup(domain, reference, young_scale=1.5)
+    actual.prepare()
+    reference.prepare()
+    material = actual.materials[1]
+    assert material.shape == (3, 18)
+    np.testing.assert_allclose(material[:, :], np.repeat([[2., 3.], [4., 21.*.2/(1.2*.6)], [4., 21./2.4]], 9, axis=1))
+    np.testing.assert_allclose(actual.materials[0][:, :], reference.materials[0][:, :])
+    material[1:3, :] = 1.5 * material[1:3, :]
+    initial = np.random.default_rng(95).normal(0., .01, (6, len(domain.nodes_coords)))
+    actual.solutions[0][:, :] = initial
+    reference.solutions[0][:, :] = initial
+    for run in range(2):
+        if run:
+            actual.reset()
+            reference.reset()
+            initial = actual.solutions[0][:, :]
+        frames = history(actual, sync)
+        np.testing.assert_allclose(frames[0], .5 * (initial[[3, 2], 0] + initial[[3, 2], 1]))
+        np.testing.assert_allclose(frames, history(reference, sync), rtol=1e-10, atol=1e-12)
+        np.testing.assert_allclose(actual.solutions[0][:, :], reference.solutions[0][:, :], rtol=1e-10, atol=1e-12)
+
+
+@pytest.mark.parametrize("defect", ["unsupported", "carrier", "missing", "overlap"])
+def test_reject_physics(defect: str) -> None:
+    solver = seismic.SGSolver(seismic.SGSolverConfig())
+    setup(mesh(), solver)
+    if defect == "unsupported":
+        solver.physics[2] = replace(solver.physics[2], type_code=20201)
+    elif defect == "carrier":
+        solver.physics[2] = replace(solver.physics[2], space_id=1)
+    elif defect == "missing":
+        del solver.physics[0]
+    else:
+        solver.physics[6] = solver.physics[0]
+    with pytest.raises(seismic.SGPrepareError) as error:
+        solver.prepare()
+    assert error.value.code == seismic.SGPrepareErrorCodeEnum.PHYSICS_FAILURE
+
+
+def test_receiver_rejected_before_run() -> None:
+    solver = seismic.SGSolver(seismic.SGSolverConfig())
+    setup(mesh(), solver)
+    solver.prepare()
+    with pytest.raises(ValueError, match="component"):
+        solver.run([replace(receiver(), comp_codes=np.array([101], dtype=np.int32))], lambda *_: None, sync=True)
+    assert solver.lifecycle == SGSolverLifecycleState.READY
+
+
+def test_cfl_stiffness_and_damping() -> None:
+    domain = mesh()
+    actual = seismic.SGSolver(seismic.SGSolverConfig(cfl_safety=.5, t_end=.01, tacts_count=1))
+    reference = tenzor.SGSolver(tenzor.SGSolverConfig(cfl_safety=.5, t_end=.01, tacts_count=1))
+    for solver in (actual, reference):
+        setup(domain, solver)
+        solver.prepare()
+    for field in ("lambda_max", "lambda_max_damping"):
+        expected = getattr(reference.spectrum, field)
+        assert expected > 0
+        np.testing.assert_allclose(getattr(actual.spectrum, field), expected, rtol=1e-7, atol=1e-12)
+
+
+def test_save_and_continue_at_physical_time() -> None:
+    domain = mesh()
+    cfg = seismic.SGSolverConfig(t_end=.01, steps_count=8, tacts_count=4, kim_beta=1/27)
+    solver = seismic.SGSolver(cfg)
+    setup(domain, solver)
+    solver.prepare()
+    initial = solver.solutions[0][:, :]
+    full = history(solver, True)
+    expected = solver.solutions[0][:, :]
+
+    solver.reset()
+    solver.solutions[0][:, :] = initial
+
+    def stop_halfway(receiver_index: int, frame: Float64Array, event: SGBaseReceiverEventData,
+                     control: SGReceiverRunControl) -> None:
+        if event.tact == 2:
+            control.save()
+            control.complete(95)
+
+    result = solver.run([receiver()], stop_halfway, sync=True)
+    assert result.code == 95
+    checkpoint = solver.solutions[0][:, :]
+    second = seismic.SGSolver(replace(cfg, t_begin=.005, steps_count=4, tacts_count=2))
+    setup(domain, second)
+    second.prepare()
+    second.solutions[0][:, :] = checkpoint
+    continuation: list[Float64Array] = []
+    second.run([receiver()], lambda _, frame, event, ctrl: continuation.append(frame.copy()), sync=True)
+    np.testing.assert_allclose(continuation, full[2:], rtol=1e-10, atol=1e-12)
+    np.testing.assert_allclose(second.solutions[0][:, :], expected, rtol=1e-10, atol=1e-12)
