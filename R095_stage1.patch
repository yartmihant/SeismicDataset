+py::object empty_spectrum(const std::shared_ptr<CompiledState>& state) {
+    SpectrumEstimate values;
+    values.by_element.resize(array_size<Real>(state->main.element_count()), 0.0);
+    return spectrum_dto(values, TimeGrid{});
+}
