+        receivers: ReceiverPackages | None,
+        callback: Callable[[int, float, int, int, int, Float64Array], None],
+        finished: Callable[[bool, bool], None],
+    ) -> None: ...
+    def handle(self) -> Handle: ...
+    def start(self, sync: bool) -> None: ...
+
