+void set_stage_exception(const char* name, Code code, const char* message) {
+    const auto type = py::module_::import("semgpu2.solvers.lin_elast_2d_seismic_newmark_kim_cu.constants").attr(name);
+    const auto error = type(code, message);
+    PyErr_SetObject(type.ptr(), error.ptr());
+}
