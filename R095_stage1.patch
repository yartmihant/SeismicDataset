diff --git a/semgpu2/src/semgpu2/solvers/lin_elast_2d_seismic_newmark_kim_cu/backend/physics.cpp b/semgpu2/src/semgpu2/solvers/lin_elast_2d_seismic_newmark_kim_cu/backend/physics.cpp
